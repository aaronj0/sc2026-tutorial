#! /bin/bash
# Runs ncu with the capabilities profiling needs, as the calling user, through the symlink of NCU_PATH
# (as the nsys wrapper does).
ncu=/usr/local/nvidia/bin/ncu
if sudo -E -n true >/dev/null 2>&1; then
  exec sudo -E -n setpriv --reuid="$(id -u)" --regid="$(id -g)" --init-groups \
    --inh-caps=+sys_admin,+sys_ptrace --ambient-caps=+sys_admin,+sys_ptrace -- "$ncu" "$@"
fi
exec "$ncu" "$@"
