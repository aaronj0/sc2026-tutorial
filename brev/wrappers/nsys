#! /bin/bash
# Runs nsys with the capabilities profiling needs, as the calling user. The profiler is the symlink of
# NSYS_PATH: nsightful clears every NSYS_* variable from the environment before it starts nsys.
nsys=/usr/local/nvidia/bin/nsys
if sudo -E -n true >/dev/null 2>&1; then
  exec sudo -E -n setpriv --reuid="$(id -u)" --regid="$(id -g)" --init-groups \
    --inh-caps=+sys_admin,+sys_ptrace --ambient-caps=+sys_admin,+sys_ptrace -- "$nsys" "$@"
fi
exec "$nsys" "$@"
